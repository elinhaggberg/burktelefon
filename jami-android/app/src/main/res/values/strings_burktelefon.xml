<resources>
    <!-- Burktelefonen kiosk launcher UI. Single-language (Swedish) by design brief. -->

    <!-- Home -->
    <string name="burk_app_name">Burktelefonen</string>
    <string name="burk_home_prompt">Vem vill du ringa?</string>
    <string name="burk_home_empty">Inga kontakter ännu.\nLägg till någon i Jami-appen.</string>
    <string name="burk_cd_call_contact">Ring till %1$s</string>
    <string name="burk_cd_settings">Inställningar</string>

    <!-- Outgoing call -->
    <string name="burk_calling">Ringer</string>
    <string name="burk_hangup">Lägg på</string>
    <string name="burk_cd_hangup">Lägg på</string>

    <!-- Incoming call (blind — no caller name/photo, by design) -->
    <string name="burk_incoming_title">Någon ringer!</string>
    <string name="burk_answer">Svara</string>
    <string name="burk_cd_answer">Svara</string>

    <!-- Connected (after answering a blind incoming call): still no name/photo —
         revealing identity by voice during the call is the point, not the screen. -->
    <string name="burk_connected_title">Börja prata!</string>

    <!-- Sleep mode -->
    <string name="burk_sleep_title">Burktelefonen\nsover</string>
    <string name="burk_sleep_opens_at">Öppnar igen kl. %1$s</string>

    <!-- Settings menu -->
    <string name="burk_settings_title">Inställningar</string>
    <string name="burk_settings_offline_today">Offline idag</string>
    <string name="burk_settings_offline_today_summary">Burktelefonen svarar inte förrän imorgon när fönstret öppnar igen.</string>
    <string name="burk_settings_kiosk_mode">Använd som hemskärm</string>
    <string name="burk_settings_kiosk_mode_summary">Låser enheten till Burktelefonen istället för Androids vanliga hemskärm.</string>
    <string name="burk_settings_leave_kiosk">Lämna kiosk-läge</string>
    <string name="burk_settings_leave_kiosk_summary">Öppnar den vanliga Jami-appen för kontakthantering.</string>
    <string name="burk_settings_close">Stäng</string>
</resources>
