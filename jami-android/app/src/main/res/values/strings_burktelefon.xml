<resources>
    <!-- Burktelefonen kiosk launcher UI. Single-language (Swedish) by design brief. -->

    <!-- Home -->
    <string name="burk_app_name">Burktelefonen</string>
    <string name="burk_home_prompt">Vem vill du ringa?</string>
    <string name="burk_home_empty">Inga kontakter ännu.\nLägg till någon i Jami-appen.</string>
    <string name="burk_cd_call_contact">Ring till %1$s</string>
    <string name="burk_cd_settings">Inställningar</string>

    <!-- Rename contact (long-press a contact on Hemskärm) -->
    <string name="burk_rename_title">Ändra namn</string>
    <string name="burk_rename_hint">Namn på Burktelefonen</string>
    <string name="burk_rename_save">Spara</string>
    <string name="burk_rename_cancel">Avbryt</string>

    <!-- Outgoing call -->
    <string name="burk_calling">Ringer</string>
    <string name="burk_hangup">Lägg på</string>
    <string name="burk_cd_hangup">Lägg på</string>

    <!-- Incoming call (blind — no caller name/photo, by design) -->
    <string name="burk_incoming_title">Någon ringer!</string>
    <string name="burk_answer">Svara</string>
    <string name="burk_cd_answer">Svara</string>

    <!-- Connected (after answering a blind incoming call): still no name/photo —
         revealing identity by voice during the call is the point, not the screen. -->
    <string name="burk_connected_title">Börja prata!</string>

    <!-- Call failed (technical failure connecting, not just an unanswered call) -->
    <string name="burk_call_failed_title">Samtalet gick inte igenom</string>
    <string name="burk_call_failed_subtitle">Fråga en vuxen om hjälp</string>
    <string name="burk_call_failed_back">Tillbaka</string>

    <!-- No internet connection -->
    <string name="burk_no_internet_title">Burktelefonen\nsaknar internet</string>

    <!-- Sleep mode -->
    <string name="burk_sleep_title">Burktelefonen\nsover</string>
    <string name="burk_sleep_opens_at">Öppnar igen kl. %1$s</string>

    <!-- Settings menu -->
    <string name="burk_settings_title">Inställningar</string>
    <string name="burk_settings_offline_today">Offline idag</string>
    <string name="burk_settings_offline_today_summary">Burktelefonen svarar inte förrän imorgon när fönstret öppnar igen.</string>
    <string name="burk_settings_kiosk_mode">Använd som hemskärm</string>
    <string name="burk_settings_leave_kiosk">Lämna kiosk-läge</string>
    <string name="burk_settings_leave_kiosk_summary">Öppnar den vanliga Jami-appen för kontakthantering.</string>
    <string name="burk_settings_close">Stäng</string>

    <!-- Parent-side settings (reached from the regular Jami app, not from inside the kiosk) -->
    <string name="burk_parent_settings_title">Burktelefonen</string>
    <string name="burk_parent_settings_menu_entry">Burktelefonen</string>
    <string name="burk_parent_settings_menu_entry_summary">Barnläge och hemskärm</string>
    <string name="burk_parent_kiosk_mode_summary">Låser enheten till Burktelefonen istället för Androids vanliga hemskärm. Efter att du slår på detta, gå till Inställningar &gt; Standardappar &gt; Hemskärm och välj Burktelefonen.</string>
    <string name="burk_parent_pin_title">Låskod för att lämna kiosk-läge</string>
    <string name="burk_parent_pin_not_set">Ingen låskod inställd — vem som helst kan lämna kiosk-läget just nu.</string>
    <string name="burk_parent_pin_set">Låskod är inställd.</string>
    <string name="burk_parent_pin_set_button">Ange låskod</string>
    <string name="burk_parent_pin_change_button">Byt låskod</string>
    <string name="burk_parent_pin_remove_button">Ta bort låskod</string>
