<resources>
    <!-- Kiosk launcher theme: off-white base, single blue accent, no action bar,
         light status/nav bar icons since the background is light. -->
    <style name="AppTheme.Burk" parent="AppThemeBase.Light">
        <item name="colorPrimary">@color/burk_blue</item>
        <item name="colorPrimaryDark">@color/burk_blue_dark</item>
        <item name="colorSecondary">@color/burk_blue</item>
        <item name="android:windowBackground">@color/burk_background</item>
        <item name="android:colorBackground">@color/burk_background</item>
        <item name="android:statusBarColor">@color/burk_background</item>
        <item name="android:navigationBarColor">@color/burk_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColor">@color/burk_ink</item>
        <item name="android:fontFamily">@font/fredoka_variable</item>
    </style>

    <!-- Display font for headings/buttons (Yeseva One, matches the design reference 1:1). -->
    <style name="Burk.Display">
        <item name="android:fontFamily">@font/yeseva_one</item>
        <item name="android:textColor">@color/burk_ink</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Body/label font (Bitter). -->
    <style name="Burk.Body">
        <item name="android:fontFamily">@font/bitter_variable</item>
        <item name="android:textColor">@color/burk_ink</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Burk.Body.SemiBold">
        <item name="android:fontFamily">@font/bitter_variable</item>
        <item name="android:fontVariationSettings">\'wght\' 600</item>
        <item name="android:textStyle">normal</item>
    </style>
</resources>
