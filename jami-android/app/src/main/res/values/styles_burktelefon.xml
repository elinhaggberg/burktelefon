<resources>
    <!-- Kiosk launcher theme: off-white base, single blue accent, no action bar,
         light status/nav bar icons since the background is light. -->
    <style name="AppTheme.Burk" parent="AppThemeBase.Light">
        <item name="colorPrimary">@color/burk_blue</item>
        <item name="colorPrimaryDark">@color/burk_blue_dark</item>
        <item name="colorSecondary">@color/burk_blue</item>
        <item name="android:windowBackground">@color/burk_background</item>
        <item name="android:colorBackground">@color/burk_background</item>
        <item name="android:statusBarColor">@color/burk_background</item>
        <item name="android:navigationBarColor">@color/burk_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColor">@color/burk_ink</item>
        <item name="android:fontFamily">@font/fredoka_variable</item>
    </style>

    <!-- Display font for headings/buttons (Yeseva One, matches the design reference 1:1).
         parent="" is required here: without it, aapt2 tries to resolve an
         implicit parent named "Burk" (stripping the last dot segment), which
         doesn't exist and fails the build. -->
    <style name="Burk.Display" parent="">
        <item name="android:fontFamily">@font/yeseva_one</item>
        <item name="android:textColor">@color/burk_ink</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Body/label font (Bitter). Explicit medium weight (not the variable
         font's thin default instance) so body text stays readable even
         without the .SemiBold variant. -->
    <style name="Burk.Body" parent="">
        <item name="android:fontFamily">@font/bitter_variable</item>
        <item name="android:fontVariationSettings">\'wght\' 500</item>
        <item name="android:textColor">@color/burk_ink</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- android:textStyle="bold" is the important part here: support for the
         variable font's weight axis (fontVariationSettings) is inconsistent
         across real devices, so relying on it alone left this text reading
         as too thin/light despite the 600 weight setting. Forcing bold
         guarantees a visibly heavier weight on every device. -->
    <style name="Burk.Body.SemiBold" parent="Burk.Body">
        <item name="android:fontFamily">@font/bitter_variable</item>
        <item name="android:fontVariationSettings">\'wght\' 700</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
