<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="9dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackgroundBorderless">

    <FrameLayout
        android:layout_width="132dp"
        android:layout_height="132dp">

        <ImageView
            android:id="@+id/burk_contact_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_burk_circle_stroke" />

        <!-- Armed by long-press, tapped to actually open the rename dialog —
             a two-step gesture so an accidental long-press (easy for a kid to
             do without meaning to) can't open editing UI on its own. -->
        <ImageView
            android:id="@+id/burk_edit_badge"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="bottom|end"
            android:src="@drawable/baseline_edit_rounded_24"
            android:visibility="gone"
            android:contentDescription="@string/burk_rename_title" />
    </FrameLayout>

    <TextView
        android:id="@+id/burk_contact_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="22sp"
        android:maxLines="1"
        android:ellipsize="end"
        style="@style/Burk.Body.SemiBold"
        tools:text="Farmor" />

</LinearLayout>
