<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/burk_background"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/burk_settings_title"
        android:textSize="24sp"
        style="@style/Burk.Display" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/burk_settings_offline_today"
                android:textSize="19sp"
                style="@style/Burk.Body.SemiBold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/burk_settings_offline_today_summary"
                android:textSize="16sp"
                android:textColor="@color/burk_ink_muted"
                style="@style/Burk.Body" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/burk_offline_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="22dp"
        android:background="@color/burk_ink_faint" />

    <!-- Note: there is deliberately no kiosk-mode toggle here anymore — a kid
         switching it off would be just as effective an escape hatch as the
         "leave kiosk mode" row below. That toggle now lives only in
         BurkParentSettingsActivity, reached from the real Jami app's
         settings, not from inside the kiosk UI. -->

    <LinearLayout
        android:id="@+id/burk_leave_kiosk_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:paddingVertical="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/burk_settings_leave_kiosk"
            android:textSize="19sp"
            android:textColor="@color/burk_blue_dark"
            style="@style/Burk.Body.SemiBold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/burk_settings_leave_kiosk_summary"
            android:textSize="16sp"
            android:textColor="@color/burk_ink_muted"
            style="@style/Burk.Body" />
    </LinearLayout>

</LinearLayout>
